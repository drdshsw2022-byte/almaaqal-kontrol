rules_version = '2';

// قواعد حماية قاعدة بيانات نظام جامعة المعقل الدولية (تسلسل هرمي للصلاحيات RBAC)
// انسخ هذا الملف إلى: Firebase Console > Firestore Database > Rules ثم اضغط Publish
//
// طرق الدخول:
//  - Google بالبريد الجامعي @almaaqal.edu.iq
//  - كلمة المرور: الكادر بحساب داخلي <اسم المستخدم>@pw.almaaqal.app
//                 الطالب بحساب داخلي <الرقم المعرفي>@st.almaaqal.app
// الكادر: staff/<البريد الجامعي>  •  الطلاب: students/<الرقم المعرفي>
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function authEmail() { return request.auth.token.email.lower(); }
    function localPart() { return authEmail().split('@')[0]; }
    function isStaffPw() { return authEmail().matches('.*@pw[.]almaaqal[.]app'); }
    function isStudentPw() { return authEmail().matches('.*@st[.]almaaqal[.]app'); }

    // بريد الكادر لحساب كلمة مرور داخلي: من فهرس usernames (مثل doc01) أو بريد الجامعة
    function staffEmailFor(name) {
      return exists(/databases/$(database)/documents/usernames/$(name))
        ? get(/databases/$(database)/documents/usernames/$(name)).data.email
        : name + '@almaaqal.edu.iq';
    }
    // البريد المكافئ لهوية المستخدم
    function email() { return isStaffPw() ? staffEmailFor(localPart()) : authEmail(); }

    // المدير العام (عدّل القائمة لتطابق superAdminEmails في config.dart)
    function isSuperAdmin() {
      return signedIn() && authEmail() in ['drdsh.sw2022@gmail.com', 'it.basra@gmail.com'];
    }

    function isMember() {
      return signedIn() && (
        (request.auth.token.email_verified == true &&
          (authEmail().matches('.*@almaaqal[.]edu[.]iq') || isSuperAdmin())) ||
        (isStaffPw() && exists(/databases/$(database)/documents/staff/$(email()))) ||
        (isStudentPw() && exists(/databases/$(database)/documents/students/$(localPart()))));
    }

    function isStaff() {
      return isMember() && exists(/databases/$(database)/documents/staff/$(email()));
    }
    function me() { return get(/databases/$(database)/documents/staff/$(email())).data; }
    function myRole() { return isStaff() ? me().role : ''; }

    // الإدارة العليا ومدير النظام: كل الجامعة
    function isTop() { return isSuperAdmin() || myRole() in ['admin', 'president']; }

    function deptCollege(deptId) {
      return get(/databases/$(database)/documents/departments/$(deptId)).data.collegeId;
    }

    // هل يدير المستخدم هذا القسم؟ (رئيس القسم لقسمه، العميد لأقسام كليته)
    function managesDept(deptId) {
      return isTop() || (deptId is string && (
        (myRole() == 'head' && me().deptId == deptId) ||
        (myRole() == 'dean' &&
          exists(/databases/$(database)/documents/departments/$(deptId)) &&
          deptCollege(deptId) == me().collegeId)));
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // الهيكل والإعدادات
    match /colleges/{id}    { allow read: if isMember() || kAny(); allow write: if isTop(); }
    match /departments/{id} { allow read: if isMember() || kAny(); allow write: if isTop(); }
    match /settings/{id}    { allow read: if isMember(); allow write: if isTop(); }
    match /meta/{id}        { allow read: if isMember(); allow write: if isTop(); }

    match /courses/{id} {
      allow read: if isMember() || kAny();
      allow create, update: if managesDept(request.resource.data.deptId);
      allow delete: if managesDept(resource.data.deptId);
    }

    match /students/{id} {
      allow read: if isMember() || (isStudentPw() && id == localPart()) || kAny();
      allow create: if managesDept(request.resource.data.deptId);
      allow update: if managesDept(request.resource.data.deptId) ||
        (isStaff() && onlyChanges(['nfcUid'])) ||
        // الطالب يثبّت تفعيل حسابه بعد تغيير كلمة المرور الأولية
        (isStudentPw() && id == localPart() && onlyChanges(['activated']));
      allow delete: if managesDept(resource.data.deptId);
    }

    function canAssign(data) {
      return isSuperAdmin() || myRole() == 'admin' ||
        (myRole() == 'president' && data.role != 'admin') ||
        (myRole() == 'dean' && data.role in ['head', 'doctor'] && managesDept(data.deptId)) ||
        (myRole() == 'head' && data.role == 'doctor' && managesDept(data.deptId));
    }

    match /staff/{staffEmail} {
      allow read: if isMember() || (signedIn() && staffEmail == email()) || kAny();
      allow create: if canAssign(request.resource.data) ||
        (staffEmail == email() && isSuperAdmin()) ||
        // أول دخول لمدير النظام admin بكلمة المرور
        (isStaffPw() && staffEmail == 'admin@almaaqal.edu.iq' &&
          staffEmail == email() && request.resource.data.role == 'admin');
      allow update: if (canAssign(resource.data) && canAssign(request.resource.data)) ||
        (staffEmail == email() && onlyChanges(['courseIds', 'activated']));
      allow delete: if canAssign(resource.data);
    }

    // فهرس أسماء المستخدمين المختارة (doc01 ← البريد) يُقرأ قبل تسجيل الدخول
    match /usernames/{name} {
      allow read: if true;
      allow write: if isTop() && name != 'admin';
    }

    match /sessions/{id} {
      allow read: if isMember();
      allow create: if isStaff() && request.resource.data.doctorId == email();
      allow update, delete: if resource.data.doctorId == email() ||
        managesDept(resource.data.deptId);
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }
    function canTakeAttendance(sessionId) {
      return isStaff() && (sessionData(sessionId).doctorId == email() ||
        managesDept(sessionData(sessionId).deptId));
    }

    match /attendance/{id} {
      allow read: if isMember();
      allow create: if canTakeAttendance(request.resource.data.sessionId) &&
        id == request.resource.data.sessionId + '_' + request.resource.data.studentId;
      allow update: if false;
      allow delete: if canTakeAttendance(resource.data.sessionId);
    }

    // ---------------- الدرجات والدروس ----------------
    function courseDept(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.deptId;
    }
    // مدرّس المادة أو من يدير قسمها
    function canGrade(courseId) {
      return isStaff() && (courseId in me().courseIds || managesDept(courseDept(courseId)));
    }

    match /schemes/{id} {
      allow read: if isMember() || kAny();
      allow write: if canGrade(request.resource.data.courseId) || kChair();
    }

    match /grades/{id} {
      // الكادر يرى الدرجات؛ الطالب يرى درجاته فقط
      allow read: if isStaff() || kGrader() ||
        (isMember() && (resource.data.studentId == localPart() ||
                        resource.data.studentEmail == authEmail()));
      allow create, update: if canGrade(request.resource.data.courseId) ||
        // رئيس الكنترول ينشر الدرجة النهائية المصادق عليها فقط
        (kChair() && (resource == null || onlyChanges(['marks', 'updatedAt', 'studentName'])));
      allow delete: if canGrade(resource.data.courseId);
    }

    match /lessons/{id} {
      allow read: if isMember();
      allow create, update: if canGrade(request.resource.data.courseId);
      allow delete: if canGrade(resource.data.courseId);
    }
  
    // =====================================================================
    // نظام الكنترول الامتحاني (مجموعات k_) — الأدوار في k_roles/<البريد>
    //   chair: رئيس اللجنة • member: عضو كنترول • auditor: مدقق درجات
    //   invigilator: مراقب • viewer: اطلاع. مدير النظام والإدارة العليا رؤساء تلقائياً.
    // =====================================================================
    // الدور في الكنترول يُحسب مرة واحدة لكل دالة (let) لتبقى القواعد ضمن حد التقييم.
    // ثلاث هويات تدخل الكنترول:
    //  1) كادر تطبيق الحضور (كلمة مرور أو Google الجامعي) — مدير النظام والإدارة العليا رؤساء تلقائياً
    //  2) حسابات الكنترول المخوّلة <اسم>@k.almaaqal.app (رئيس النظام ومعاونه، رئيس المشرفين ومعاونه، رئيس الأساتذة ومعاونه)
    //     تُربط بمعرّف الحساب (uid) عند إنشائها حتى لا ينتحلها حساب آخر بالاسم نفسه
    //  3) حساب Google قَبِل المدير طلب انضمامه وحدد دوره
    // التصريح في k_roles/<الهوية>: role، rank، uid، until (انتهاء اختياري بالمللي ثانية)، off (موقوف)
    function kAcct() { return signedIn() && authEmail().matches('.*@k[.]almaaqal[.]app'); }
    // بريد موثَّق (حساب Google): يملك صاحبه البريد فعلاً
    function kGoogle() { return signedIn() && request.auth.token.email_verified == true; }
    function kMe() {
      let p = /databases/$(database)/documents/k_roles/$(email());
      return signedIn() && exists(p) ? get(p).data : {};
    }
    function kRoleNow() {
      let e = email();
      let staffOk = signedIn() && (isStaffPw() || (request.auth.token.email_verified == true &&
        authEmail().matches('.*@almaaqal[.]edu[.]iq'))) &&
        exists(/databases/$(database)/documents/staff/$(e));
      let kr = kMe();
      let live = kr.get('off', false) != true &&
        (kr.get('until', 0) == 0 || kr.get('until', 0) > request.time.toMillis()) &&
        (!kAcct() || kr.get('uid', '') == request.auth.uid);
      return isSuperAdmin() ? 'chair' :
        staffOk && get(/databases/$(database)/documents/staff/$(e)).data.get('role', '') in ['admin', 'president'] ? 'chair' :
        (staffOk || kAcct() || kGoogle()) && live ? kr.get('role', '') : '';
    }
    function kRole()   { return kRoleNow(); }
    function kChair()  { return kRoleNow() == 'chair'; }
    function kCtrl()   { return kRoleNow() in ['chair', 'member']; }
    function kGrader() { return kRoleNow() in ['chair', 'member', 'auditor']; }
    function kInvig()  { return kRoleNow() in ['chair', 'member', 'invigilator']; }
    function kAny()    { return kRoleNow() in ['chair', 'member', 'auditor', 'invigilator', 'viewer']; }
    match /k_roles/{e} {
      allow read: if kChair() || (signedIn() && e == email());
      // رئيس اللجنة يمنح التصاريح، عدا تصريحه هو (منعاً لإقفال نفسه)، وتصريح رئيس النظام لرئيس النظام والمدير العام فقط
      allow create, update: if kChair() && e != email() &&
        (resource == null || resource.data.get('rank', '') != 'g1' || isSuperAdmin() || kMe().get('rank', '') == 'g1') &&
        (request.resource.data.get('rank', '') != 'g1' || isSuperAdmin() || kMe().get('rank', '') == 'g1') &&
        request.resource.data.role in ['chair', 'member', 'auditor', 'invigilator', 'viewer'] &&
        request.resource.data.by == email();
      allow delete: if kChair() && e != email() &&
        (resource.data.get('rank', '') != 'g1' || isSuperAdmin() || kMe().get('rank', '') == 'g1');
    }
    // طلبات الانضمام: صاحب حساب Google (أو أستاذ من تطبيق الحضور) يطلب باسمه، ويقبله المدير أو رئيس اللجنة ويحدد دوره
    match /k_requests/{e} {
      allow read: if (signedIn() && e == email()) || kChair();
      allow create: if signedIn() && e == email() && (kGoogle() || isStaff()) &&
        request.resource.data.keys().hasOnly(['email', 'name', 'photo', 'note', 'at', 'status']) &&
        request.resource.data.status == 'pending' && request.resource.data.email == e;
      allow update: if (signedIn() && e == email() && resource.data.status == 'pending' &&
          onlyChanges(['note', 'name'])) || kChair();
      allow delete: if (signedIn() && e == email()) || kChair();
    }
    // الإعدادات والتشكيل والمصادقة (locks)
    match /k_meta/{id}     { allow read: if kAny(); allow write: if kChair(); }
    match /k_halls/{id}    { allow read: if kAny(); allow write: if kCtrl(); }
    match /k_exams/{id}    { allow read: if kAny(); allow write: if kCtrl(); }
    match /k_staffx/{id}   { allow read: if kAny(); allow write: if kCtrl(); }
    // المقاعد والمراقبون والحضور: المراقب يعدّل الحضور فقط
    match /k_slots/{id} {
      allow read: if kAny();
      allow write: if kCtrl();
      allow update: if kRole() == 'invigilator' && onlyChanges(['att']);
    }
    match /k_envelopes/{id} { allow read: if kAny(); allow write: if kInvig(); }
    match /k_incidents/{id} {
      allow read: if kAny();
      allow create: if kInvig();
      allow update, delete: if kCtrl();
    }
    // الاعتراضات: مسار موثق. التسجيل لأعضاء الكنترول، والتدقيق والمراجعة للمدققين،
    // وإغلاق الاعتراض (القرار وتعديل الدرجة) لرئيس اللجنة باسمه فقط.
    function apClosed(d) { return d.get('st', 'new') in ['done', 'rejected']; }
    function apDecisionKeys() {
      return ['outcome', 'finalFin', 'decidedBy', 'decidedAt', 'decisionReason',
              'oldFin', 'oldTotal', 'student', 'course', 'round', 'ref', 'at', 'createdBy'];
    }
    function apUpdateOk(r) {
      return !apClosed(resource.data) && (
        (r == 'chair' &&
          (!apClosed(request.resource.data) || request.resource.data.get('decidedBy', '') == email())) ||
        (r in ['member', 'auditor'] && !apClosed(request.resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(apDecisionKeys())));
    }
    match /k_appeals/{id} {
      allow read: if kAny();
      allow create: if kCtrl() && request.resource.data.get('st', '') == 'new' &&
        request.resource.data.get('createdBy', '') == email() &&
        !request.resource.data.keys().hasAny(['outcome', 'finalFin', 'decidedBy']);
      allow update: if apUpdateOk(kRoleNow());
      allow delete: if kChair();
    }
    // الرصد المزدوج الأعمى والرأفة: يُرفض الرصد على مرحلة صادق رئيس اللجنة على نتائجها
    function marksLocked(cid) {
      return exists(/databases/$(database)/documents/k_meta/locks) &&
        exists(/databases/$(database)/documents/courses/$(cid)) &&
        get(/databases/$(database)/documents/k_meta/locks).data.get(
          get(/databases/$(database)/documents/courses/$(cid)).data.deptId + '_' +
          string(get(/databases/$(database)/documents/courses/$(cid)).data.stage), null) != null;
    }
    function marksWriteOk(r, cid) {
      return r == 'chair' || (r in ['member', 'auditor'] && !marksLocked(cid));
    }
    match /k_marks/{id} {
      allow read: if kGrader();
      allow write: if marksWriteOk(kRoleNow(), id);
    }
    // الأرقام السرية: يولّدها الكنترول، ويفك تشفيرها رئيس اللجنة فقط
    match /k_codes/{id} {
      allow read, create: if kCtrl();
      allow update, delete: if kChair();
    }
    // سجل التدقيق: إضافة فقط باسم المستخدم نفسه، ولا تعديل ولا حذف لأي أحد
    match /k_audit/{id} {
      allow read: if kAny();
      allow create: if kAny() && request.resource.data.by == email();
      allow update, delete: if false;
    }
  }
}
